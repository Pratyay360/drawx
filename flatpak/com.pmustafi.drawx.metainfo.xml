<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.pmustafi.drawx</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>DrawX</name>
  <summary>Offline-first brainstorming and whiteboard</summary>
  <description>
    <p>DrawX is an offline-first brainstorming and whiteboard application built with Excalidraw. Sketch diagrams, wireframes and ideas locally without requiring a network connection.</p>
    <p>Features:</p>
    <ul>
      <li>Infinite canvas powered by Excalidraw</li>
      <li>Works fully offline — your data stays on device</li>
      <li>File open/save via native dialogs</li>
      <li>Light and dark themes</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.pmustafi.drawx.desktop</launchable>
  <provides>
    <id>com.pmustafi.drawx.desktop</id>
  </provides>
