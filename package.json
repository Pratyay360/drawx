{
	"name": "drawx",
	"version": "0.9.9",
	"type": "module",
	"imports": {
		"#components/*": "./src/components/*.tsx",
		"#lib/*": "./src/lib/*.ts",
		"#hooks/*": "./src/hooks/*.ts"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"typecheck": "tsc --noEmit",
		"preview": "vite preview",
		"tauri": "tauri",
		"lint": "biome lint .",
		"tauri:build": "tauri build && source src-tauri/scripts/patch-appimage-wayland.sh",
		"flatpak:sources": "bun scripts/flatpak-sources.ts",
		"lint:fix": "biome lint --fix",
		"format": "biome format --write ."
	},
	"dependencies": {
		"@astryxdesign/cli": "^0.7.1",
		"@astryxdesign/core": "^0.7.1",
		"@astryxdesign/theme-matcha": "^0.7.1",
		"@astryxdesign/theme-neutral": "^0.7.1",
		"@astryxdesign/theme-stone": "^0.7.1",
		"@astryxdesign/theme-y2k": "^0.7.1",
		"@excalidraw/excalidraw": "^0.18.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@hugeicons/core-free-icons": "^4.3.5",
		"@hugeicons/react": "^1.1.10",
		"@iconify/react": "^6.0.3",
		"@microsoft/clarity": "^1.0.2",
		"@phosphor-icons/react": "^2.1.10",
		"@sentry/react": "11.8.0",
		"@sentry/vite-plugin": "^11.8.0",
		"@stylexjs/stylex": "^0.19.1",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-clipboard-manager": "^2.5.0",
		"@tauri-apps/plugin-dialog": "^2.8.3",
		"@tauri-apps/plugin-fs": "^2.7.1",
		"@tauri-apps/plugin-log": "^2.10.1",
		"@tauri-apps/plugin-opener": "^2.7.2",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@tauri-apps/plugin-updater": "^2.14.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.60.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router-dom": "^7.18.4",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@oxlint/plugins": "1.89.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.12.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"astryx": "^0.0.0",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"typescript": "~7.0.2",
		"vite": "^8.3.4",
		"zustand": "^5.0.15"
	},
	"packageManager": "bun@1.4.1",
	"trustedDependencies": [
		"@astryxdesign/cli",
		"@astryxdesign/core"
	],
	"allowScripts": {
		"@astryxdesign/cli": true,
		"@astryxdesign/core": true
	}
}
