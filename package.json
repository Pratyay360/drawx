{
	"name": "drawx",
	"version": "0.7.28",
	"type": "module",
	"imports": {
		"#components/*": "./src/components/*.tsx",
		"#lib/*": "./src/lib/*.ts",
		"#hooks/*": "./src/hooks/*.ts"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"typecheck": "tsc --noEmit",
		"preview": "vite preview",
		"tauri": "tauri",
		"lint": "biome lint .",
		"tauri:build": "tauri build && bash src-tauri/scripts/patch-appimage-wayland.sh",
		"lint:fix": "biome lint --fix",
		"format": "biome format --write ."
	},
	"dependencies": {
		"@astryxdesign/cli": "^0.5.4",
		"@astryxdesign/core": "^0.5.4",
		"@astryxdesign/theme-matcha": "^0.5.4",
		"@astryxdesign/theme-neutral": "^0.5.4",
		"@astryxdesign/theme-stone": "^0.6.0",
		"@astryxdesign/theme-y2k": "^0.5.4",
		"@excalidraw/excalidraw": "^0.18.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@hugeicons/core-free-icons": "^4.3.5",
		"@hugeicons/react": "^1.1.10",
		"@iconify/react": "^6.0.2",
		"@phosphor-icons/react": "^2.1.10",
		"@stylexjs/stylex": "^0.19.1",
		"@tauri-apps/api": "^2.12.1",
		"@tauri-apps/plugin-clipboard-manager": "^2.4.1",
		"@tauri-apps/plugin-dialog": "^2.8.1",
		"@tauri-apps/plugin-fs": "^2.6.0",
		"@tauri-apps/plugin-log": "^2.10.0",
		"@tauri-apps/plugin-opener": "^2.7.0",
		"@tauri-apps/plugin-process": "^2.4.0",
		"@tauri-apps/plugin-updater": "^2.13.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.53.0",
		"radix-ui": "^1.7.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router-dom": "^7.18.4",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@oxlint/plugins": "1.81.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.12.1",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"astryx": "^0.0.0",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"typescript": "~7.0.2",
		"vite": "^8.3.4",
		"zustand": "^5.0.15"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "^1.4.2",
			"onFail": "warn"
		}
	},
	"packageManager": "bun@1.4.2+sha512.4eb497a3a1c97c811a733a5bde48d7f36236a4be3bbcad5050d98744251dcfd23368ec1af65cce5d25b0bb6975f181c4dec35f1916a954b7789cd9bedb6bd554",
	"trustedDependencies": [
		"@astryxdesign/cli",
		"@astryxdesign/core"
	],
	"allowBuilds": {
		"@astryxdesign/cli": true,
		"@astryxdesign/core": true
	}
}
